# aggcenter environment configuration.
# Copy to `.env.local` for local development (never commit real secrets).
# In Cursor Cloud Agents, prefer setting these as Secrets.

# ---- Reporting ----
REPORTING_CURRENCY=USD

# ---- File storage (OCI Object Storage via the Swift API, HTTP Basic Auth) ----
# STORAGE_PROVIDER: "local" (default) or "oci"
STORAGE_PROVIDER=local
#
# Option A (matches the OCI "storage URL"): give the FULL container URL. Then
# namespace/bucket/region are optional (they're already in the URL):
# OCI_SWIFT_BASE_URL=https://swiftobjectstorage.<region>.oraclecloud.com/v1/<namespace>/<bucket>
#
# Option B: give the pieces and we build the URL for you:
# OCI_BUCKET=aggcenter-statements
# OCI_NAMESPACE=your-object-storage-namespace
# OCI_REGION=us-ashburn-1
# OCI_SWIFT_BASE_URL is then optional (derived from region).
#
# Secret credentials — put these in the Secrets panel, NOT in this file or git.
# Username is your identity-domain user, used verbatim (namespace is in the URL):
# OCI_SWIFT_USER=oracleidentitycloudservice/<user>
# OCI_SWIFT_PASSWORD=<OCI auth token>   # generated in the console; used as the password

# ---- Reference data (Snowflake) ----
# DATA_SOURCE: "local" (default, uses bundled sample data) or "snowflake"
DATA_SOURCE=local
# SNOWFLAKE_ACCOUNT=xy12345.us-east-1
# SNOWFLAKE_USER=aggcenter_svc
# SNOWFLAKE_DATABASE=FINANCE
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_SCHEMA=PUBLIC
# SNOWFLAKE_ROLE=ANALYST

# ---- Optional external API for extra reference data ----
# EXTERNAL_API_BASE_URL=https://api.example.com
