# aggcenter environment configuration.
# Copy to `.env.local` for local development (never commit real secrets).
# In Cursor Cloud Agents, prefer setting these as Secrets.

# ---- Reporting ----
REPORTING_CURRENCY=USD

# ---- Database (Postgres / Neon) ----
# When set, uploaded statements + transactions persist to Postgres (schema
# "aggc-cash"); when unset, a local JSON store is used. Secret — use Secrets.
# Neon (pooled connection string):
# DATABASE_URL=postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# Local Postgres:
# DATABASE_URL=postgresql://user:password@localhost:5432/aggcenter
# DATABASE_SSL_NO_VERIFY=false   # set true only to skip TLS cert verification

# ---- File storage (OCI Object Storage via the Swift API, HTTP Basic Auth) ----
# STORAGE_PROVIDER: "local" (default) or "oci"
STORAGE_PROVIDER=local
#
# Option A (matches the OCI "storage URL"): give the FULL container URL. Then
# namespace/bucket/region are optional (they're already in the URL):
# OCI_SWIFT_BASE_URL=https://swiftobjectstorage.<region>.oraclecloud.com/v1/<namespace>/<bucket>
#
# Option B: give the pieces and we build the URL for you:
# OCI_BUCKET=aggcenter-statements
# OCI_NAMESPACE=your-object-storage-namespace
# OCI_REGION=us-ashburn-1
# OCI_SWIFT_BASE_URL is then optional (derived from region).
#
# Secret credentials — put these in the Secrets panel, NOT in this file or git.
# Username is your identity-domain user, used verbatim (namespace is in the URL):
# OCI_SWIFT_USER=oracleidentitycloudservice/<user>
# OCI_SWIFT_PASSWORD=<OCI auth token>   # generated in the console; used as the password

# ---- Reference data (Snowflake) ----
# DATA_SOURCE: "local" (default, uses bundled sample data) or "snowflake"
DATA_SOURCE=local
# SNOWFLAKE_ACCOUNT=xy12345.us-east-1
# SNOWFLAKE_USER=aggcenter_svc
# SNOWFLAKE_DATABASE=FINANCE
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_SCHEMA=PUBLIC
# SNOWFLAKE_ROLE=ANALYST

# ---- Optional external API for extra reference data ----
# EXTERNAL_API_BASE_URL=https://api.example.com

# ---- Statement / reference ingest prefixes (UK cash management) ----
# All cash files default to one org root with short folder names. Override the
# root, or a single full prefix, if a bucket still uses a split layout.
# CASH_ORG_ROOT=aggCenter/ORG_112 - UK
#
# Bank statements (CSV and PDF) live under {CASH_ORG_ROOT}/bank/
#   CSV:  aggCenter/ORG_112 - UK/bank/<accountId>/<file>.csv
#   PDF:  aggCenter/ORG_112 - UK/bank/<bankCode>/<file>.pdf  (UK-HSBC → HSBC parser)
# STATEMENT_CSV_PREFIX=aggCenter/ORG_112 - UK/bank
# STATEMENT_PDF_PREFIX=aggCenter/ORG_112 - UK/bank
#
# Reference docs:
#   inv  AP invoices          (REFERENCE_AP_PREFIX)
#   po   purchase orders      (REFERENCE_PO_PREFIX)
#   so   sales orders         (REFERENCE_SO_PREFIX)
#   rem  remittances          (REFERENCE_REMITTANCE_PREFIX)
# REFERENCE_AP_PREFIX=aggCenter/ORG_112 - UK/inv
# REFERENCE_PO_PREFIX=aggCenter/ORG_112 - UK/po
# REFERENCE_SO_PREFIX=aggCenter/ORG_112 - UK/so
# REFERENCE_REMITTANCE_PREFIX=aggCenter/ORG_112 - UK/rem
# Supplier master data (profile / site / address / VAT ID extracts):
# SUPPLIER_PREFIX=supplier
# Fusion Supplier FBDI output (ZIP + CSVs for Import Suppliers):
# SUPPLIER_FBDI_PREFIX=aggcenter/FBDI/supplier
# Invoice parser (PDF / DOCX / XLSX / CSV) pipeline folders:
#   aggcenter/invoices/landing|received|processed|archived|anomaly
# INVOICE_PREFIX=aggcenter/invoices
#
# Seed bundled sample invoices into an empty landing folder. Off by default so
# real OCI buckets are not polluted. Local demos: set true.
# INVOICE_SEED_SAMPLES=false
#
# LLM-assisted classify (schema-constrained JSON → InvoiceParseResult).
# Extracted invoice text is sent to the configured model provider when this
# path runs. Never commit the API key.
# INVOICE_LLM_CLASSIFY=false
# INVOICE_LLM_MODEL=gpt-4o-mini
# INVOICE_LLM_API_BASE=https://api.openai.com/v1
# INVOICE_LLM_API_KEY=
# INVOICE_LLM_TIMEOUT_MS=30000
# Use Hotjar/Tesla/Origin overlays when they parse with high confidence:
# INVOICE_STATIC_FAST_PATH=true
#
# Official EU VIES REST API (no key) used to validate VAT IDs and fetch the
# registered name/address. Override only to point at the VIES test service.
# VIES_API_URL=https://ec.europa.eu/taxation_customs/vies/rest-api
