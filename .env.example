# aggcenter environment configuration.
# Copy to `.env.local` for local development (never commit real secrets).
# In Cursor Cloud Agents, prefer setting these as Secrets.

# ---- Reporting ----
REPORTING_CURRENCY=USD

# ---- File storage (OCI Object Storage) ----
# STORAGE_PROVIDER: "local" (default) or "oci"
STORAGE_PROVIDER=local
#
# Bucket/region are not secret:
# OCI_BUCKET=aggcenter-statements
# OCI_REGION=us-ashburn-1
# OCI_NAMESPACE=your-namespace          # optional; auto-detected if omitted
#
# --- Auth option A: env-based (recommended for Cursor Secrets) ---
# Put the SECRET values below in the Secrets panel, NOT in this file or git.
# OCI_TENANCY=ocid1.tenancy.oc1..xxxx
# OCI_USER=ocid1.user.oc1..xxxx
# OCI_FINGERPRINT=aa:bb:cc:dd:...
# OCI_PRIVATE_KEY_PASSPHRASE=            # optional
# Provide the API private key as base64 (single line, avoids newline issues):
#   base64 -w0 ~/.oci/oci_api_key.pem
# OCI_PRIVATE_KEY_B64=LS0tLS1CRUdJTi...
# ...or as a raw PEM (literal \n are normalized):
# OCI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
#
# --- Auth option B: OCI config file on disk ---
# OCI_CONFIG_FILE=/path/to/oci/config
# OCI_CONFIG_PROFILE=DEFAULT

# ---- Reference data (Snowflake) ----
# DATA_SOURCE: "local" (default, uses bundled sample data) or "snowflake"
DATA_SOURCE=local
# SNOWFLAKE_ACCOUNT=xy12345.us-east-1
# SNOWFLAKE_USER=aggcenter_svc
# SNOWFLAKE_DATABASE=FINANCE
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_SCHEMA=PUBLIC
# SNOWFLAKE_ROLE=ANALYST

# ---- Optional external API for extra reference data ----
# EXTERNAL_API_BASE_URL=https://api.example.com
